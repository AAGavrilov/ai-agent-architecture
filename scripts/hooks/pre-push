#!/usr/bin/env bash
# pre-push hook: полный deterministic harness перед отправкой в общую ветку.
#
# Устанавливается через scripts/install-hooks.sh: git не версионирует .git/hooks,
# поэтому сам хук лежит в scripts/hooks/ и копируется установщиком.
#
# Почему на push, а не на commit: артефактный коммит и следующий за ним state-коммит
# создаются парой, и между ними состояние легально промежуточное. Проверять имеет
# смысл то, что уходит наружу.
#
# Осознанный обход (не для CI): git push --no-verify
set -uo pipefail

cd "$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: не удалось определить корень репозитория — пропускаю" >&2
  exit 0
}

if [[ ! -f tests/harness/check-all.sh ]]; then
  echo "pre-push: tests/harness/check-all.sh не найден — пропускаю" >&2
  exit 0
fi

echo "pre-push: запускаю deterministic harness (bash tests/harness/check-all.sh)"

if bash tests/harness/check-all.sh; then
  echo "pre-push: harness PASS — push разрешён"
  exit 0
else
  status=$?
fi

echo "" >&2
echo "pre-push: harness FAIL (exit $status) — push остановлен." >&2
echo "pre-push: исправь расхождение (контракт — .agents/HARNESS_CONTRACT.md)" >&2
echo "pre-push: осознанный обход — git push --no-verify" >&2
exit 1
